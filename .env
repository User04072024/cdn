# Connection string dari MongoDB Atlas (Database > Connect > Drivers)
# Contoh: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/cdn?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://xarchivery_db_user:7LoX9JsF1RF38N5d@cluster0.m5yt1zc.mongodb.net/cdn?retryWrites=true&w=majority&appName=CylicDv

# Opsional. Kalau connection string di atas gak nyantumin nama database,
# atau kamu mau pakai nama lain, isi di sini.
MONGODB_DB=cdn

# Opsional. Limit ukuran file dalam bytes. Default 4MB (batas keras Vercel
# Serverless Function). Kalau host sendiri (bukan Vercel), boleh dinaikkan.
MAX_FILE_SIZE=4194304

# Dipakai internal buat deteksi environment Vercel, JANGAN diisi manual —
# Vercel otomatis nge-set ini sendiri saat deploy.
# VERCEL=1
